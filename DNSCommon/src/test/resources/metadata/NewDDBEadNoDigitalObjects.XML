<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vereinfachtes Beispiel eines Findbuchs im Format EAD(DDB) 1.2.

  Dieses Findbuch enthaelt KEINE Verzeichnungseinheit mit Digitalisat
  (kein daogrp/daoloc). Daher liefert getLicensesForWholeEAD() eine leere
  Liste und isPublishable() muss false ergeben.
-->
<ead xmlns="urn:isbn:1-931666-22-9"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="urn:isbn:1-931666-22-9 http://www.loc.gov/ead/ead.xsd http://www.w3.org/1999/xlink http://www.loc.gov/standards/xlink/xlink.xsd"
     audience="external">

  <eadheader countryencoding="iso3166-1"
             dateencoding="iso8601"
             langencoding="iso639-2b"
             repositoryencoding="iso15511"
             scriptencoding="iso15924">
    <eadid mainagencycode="DE-1234">FB-002</eadid>
    <filedesc>
      <titlestmt>
        <titleproper>Findbuch ohne Digitalisate</titleproper>
      </titlestmt>
    </filedesc>
  </eadheader>

  <archdesc level="collection" type="Findbuch">
    <did>
      <unitid>Bestand C 200</unitid>
    </did>

    <!-- Globale Lizenz fuer die Metadaten des Bestands: CC0 1.0. -->
    <userestrict type="ead">
      <head>Lizenz der Metadaten</head>
      <p>
        <extref xlink:href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal Public Domain Dedication</extref>
      </p>
    </userestrict>

    <!-- Globale Lizenz fuer die Digitalisate des Bestands: CC BY 4.0. -->
    <userestrict type="dao">
      <head>Lizenz der Digitalisate</head>
      <p>
        <extref xlink:href="http://creativecommons.org/licenses/by/4.0/">CC BY 4.0 International</extref>
      </p>
    </userestrict>

    <dsc>
      <c level="collection" id="bestand-c-200">
        <did>
          <unitid>C 200</unitid>
          <unittitle>Bestand ohne Digitalisate</unittitle>
        </did>

        <c level="file" id="archivale-c-200-001">
          <did>
            <unitid>C 200/1</unitid>
            <unittitle type="title">Analoges Archivale ohne Scan</unittitle>
          </did>
        </c>
      </c>
    </dsc>
  </archdesc>
</ead>
